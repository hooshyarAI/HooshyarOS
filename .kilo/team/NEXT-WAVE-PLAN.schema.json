{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HooshyarOS Team Next Wave Plan",
  "type": "object",
  "required": [
    "schema_version",
    "wave_status",
    "base_mission",
    "leases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "wave_status": {
      "enum": [
        "READY",
        "BLOCKED",
        "COMPLETE",
        "NOT_READY"
      ]
    },
    "base_mission": {
      "type": "string",
      "minLength": 1
    },
    "created_from_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "leases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "focus",
          "owner",
          "mode",
          "task_class",
          "write_scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "AUDIT",
              "IMPLEMENT",
              "REVIEW",
              "VERIFY"
            ]
          },
          "task_class": {
            "enum": [
              "PLAN",
              "AUDIT",
              "IMPLEMENT",
              "REPAIR",
              "REVIEW",
              "VERIFY",
              "QC",
              "MEMORY"
            ]
          },
          "write_scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
