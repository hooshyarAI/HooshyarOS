{
  "name": "hooshyaros",
  "version": "1.0.0",
  "description": "HooshyarOS HBOS Core",
  "main": "index.js",
  "scripts": {
    "test": "node ./node_modules/jest/bin/jest.js",
    "build": "tsc --noEmit",
    "product": "tsx Backend/HBOS/Autonomous/Runtime/CommercialRuntimeServer.ts",
    "product:test": "node ./node_modules/jest/bin/jest.js --runInBand Backend/HBOS/test/CommercialRuntimeServer.test.ts",
    "start": "tsx Backend/HBOS/Autonomous/Runtime/CommercialRuntimeServer.ts",
    "serve": "tsx Backend/HBOS/Autonomous/Runtime/CommercialRuntimeServer.ts",
    "autonomous:build": "tsx Backend/HBOS/Autonomous/Runtime/AutonomousBuildDaemon.ts",
    "autonomous:assistant": "python Backend/AI_Runtime/autonomous_assistant.py",
    "autonomous:platform": "python Backend/AI_Runtime/hooshyar_build.py platform"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
